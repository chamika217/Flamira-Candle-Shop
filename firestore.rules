rules_version = '2';

// ---------------------------------------------------------------------------
// IMPORTANT — PRAGMATIC CLIENT-SIDE APPROACH
// Order creation currently runs from the browser using the modular SDK.
// The original architecture plan calls for moving order writes to a
// server-side Route Handler (Firebase Admin SDK), which would let us
// remove the `orders: create`, `products: update`, and `counters: *`
// client permissions below entirely. Revisit before scaling to production.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // products — public read for active items only
    // Clients may ONLY update stockQty (and updatedAt) — no other fields.
    // This supports the guest-checkout stock-decrement flow.
    // Authenticated admins may read all products and perform full writes
    // (needed by Product Management and Inventory pages).
    // -------------------------------------------------------------------------
    match /products/{productId} {
      // Public read — status filtering happens in application code via
      // where("status", "==", "active") queries. The resource.data.status
      // check does not work reliably on collection list queries.
      allow read: if true;

      allow update: if
        // Authenticated admins may update any fields
        request.auth != null ||
        (
          // Unauthenticated clients may only touch stockQty + updatedAt (checkout decrement)
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stockQty', 'updatedAt']) &&
          request.resource.data.stockQty < resource.data.stockQty
        );

      allow create, delete: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // products/{productId}/stockHistory — admin read/write only
    // Populated by adjustStock(); future: also by order-driven stock changes.
    // -------------------------------------------------------------------------
    match /products/{productId}/stockHistory/{entryId} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // categories — public read; no client writes
    // -------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // orders — anyone may CREATE (guest checkout).
    // Anyone may READ by orderNumber (order confirmation page needs this —
    // the order number is unguessable so this is safe for now).
    // Only authenticated users (admins) may update. No deletes ever.
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // counters/orders — the order-number sequence document
    // Clients need get + update + create (first order initialises the doc).
    // -------------------------------------------------------------------------
    match /counters/orders {
      allow get, update, create: if true;
      allow list, delete: if false;
    }

    // -------------------------------------------------------------------------
    // admins — authenticated users may read their OWN document only.
    // This allows the admin panel to fetch the role/profile on login.
    // No client writes — admin documents are created manually in the console.
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // reviews — public read for approved reviews; public create (order
    // verification is done in application code, not Firestore rules, since
    // the app currently uses the client SDK throughout).
    //
    // NOTE: Moderation writes (approve/reject, reply, feature, delete) rely on
    // the admin being authenticated (request.auth != null). Tightening this to
    // role-based checks would require a server-side Route Handler with the
    // Firebase Admin SDK — a known gap to close in a future pass.
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read:   if resource.data.approved == true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // coupons — public clients need to validate coupon codes at checkout.
    // Only authenticated admins may create, update, or delete.
    // -------------------------------------------------------------------------
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // customers — authenticated users may read/write their OWN document only.
    // No public access — profile data is sensitive.
    // -------------------------------------------------------------------------
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------------
    // settings/general — public clients need to read delivery rates for checkout.
    // Only authenticated admins may write (to update rates via the admin panel).
    // -------------------------------------------------------------------------
    match /settings/general {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other settings documents remain server/admin only
    match /settings/{document} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // Default deny — any collection not explicitly listed above
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
